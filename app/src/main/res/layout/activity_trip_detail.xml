<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_aplikasi"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/tripDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombolKembaliTripDetail"
            style="@style/Widget.Jelajah.IconCircle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/cd_back"
            app:icon="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tripDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:textColor="@color/teks_utama"
                android:textFontWeight="800"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/tripDetailSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/teks_sekunder"
                android:textSize="10.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombolEditTrip"
            style="@style/Widget.Jelajah.IconCircle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/trip_edit"
            app:icon="@drawable/ic_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tombolHapusTrip"
            style="@style/Widget.Jelajah.IconCircle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/action_delete"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/merah" />
    </LinearLayout>

    <TextView
        android:id="@+id/tripDetailNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="4dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/teks_sekunder"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tripDetailRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/tripDetailEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/trip_no_items"
        android:textColor="@color/teks_sekunder"
        android:textSize="12.5sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tombolTambahItem"
        style="@style/Widget.Jelajah.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="18dp"
        android:text="@string/trip_add_item"
        app:icon="@drawable/ic_add"
        app:iconSize="18dp" />
</LinearLayout>
