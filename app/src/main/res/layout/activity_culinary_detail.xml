<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/culinaryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_aplikasi"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/culinaryScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="310dp">

                <ImageView
                    android:id="@+id/culinaryHeroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_scrim_bottom" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:background="@drawable/bg_hero_scrim_top" />

                <LinearLayout
                    android:id="@+id/culinaryHeroActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombolKembaliCulinary"
                        style="@style/Widget.Jelajah.IconCircle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/cd_back"
                        app:backgroundTint="@color/putih_transparan"
                        app:icon="@drawable/ic_arrow_back"
                        app:iconTint="@color/white"
                        app:strokeColor="@color/putih_transparan_kuat" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombolFavoritCulinary"
                        style="@style/Widget.Jelajah.IconCircle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@string/cd_favorite"
                        app:backgroundTint="@color/putih_transparan"
                        app:icon="@drawable/ic_heart"
                        app:iconTint="@color/white"
                        app:strokeColor="@color/putih_transparan_kuat" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombolBagikanCulinary"
                        style="@style/Widget.Jelajah.IconCircle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/cd_share"
                        app:backgroundTint="@color/putih_transparan"
                        app:icon="@drawable/ic_share"
                        app:iconTint="@color/white"
                        app:strokeColor="@color/putih_transparan_kuat" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="@string/culinary_hero_label"
                        android:textColor="@color/pasir_kuning"
                        android:textFontWeight="700"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/culinaryTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textColor="@color/white"
                        android:textFontWeight="800"
                        android:textSize="30sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_location"
                            app:tint="@color/putih_80" />

                        <TextView
                            android:id="@+id/culinaryOrigin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:textColor="@color/putih_80"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star"
                            app:tint="@color/pasir_kuning" />

                        <TextView
                            android:id="@+id/culinaryRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/white"
                            android:textFontWeight="700"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/permukaan_lembut"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/koral_lembut"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/culinary_price_label"
                                android:textColor="@color/teks_tersier"
                                android:textSize="9.5sp" />

                            <TextView
                                android:id="@+id/culinaryPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:textColor="@color/koral_gelap"
                                android:textFontWeight="700"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="34dp"
                            android:background="@color/koral_lembut" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/culinary_reviews_label"
                                android:textColor="@color/teks_tersier"
                                android:textSize="9.5sp" />

                            <TextView
                                android:id="@+id/culinaryReviews"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:textColor="@color/teks_utama"
                                android:textFontWeight="700"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/culinary_about"
                    android:textColor="@color/teks_utama"
                    android:textFontWeight="700"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/culinaryDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/teks_sekunder"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/culinary_flavour"
                    android:textColor="@color/teks_utama"
                    android:textFontWeight="700"
                    android:textSize="18sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/flavorChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="2dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/permukaan"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/garis_lembut"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_coral">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_menu_culinary"
                                app:tint="@color/koral_gelap" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/culinary_best_at"
                                android:textColor="@color/koral_gelap"
                                android:textFontWeight="700"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/culinaryBestAt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/teks_sekunder"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/pasir_kuning"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginTop="1dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info"
                            app:tint="@color/coklat_tua" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/culinary_tips_title"
                                android:textColor="@color/coklat_tua"
                                android:textFontWeight="700"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/culinaryTips"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/coklat_tua"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/culinary_related_title"
                    android:textColor="@color/teks_utama"
                    android:textFontWeight="700"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/culinary_related_sub"
                    android:textColor="@color/teks_sekunder"
                    android:textSize="11sp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/culinaryRelatedCard"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="9dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/permukaan"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/nav_ripple"
                    app:strokeColor="@color/garis_lembut"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="9dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/culinaryRelatedImage"
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Jelajah.Rounded18" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/culinary_related_cta"
                                android:textColor="@color/hijau_lombok"
                                android:textFontWeight="700"
                                android:textSize="9.5sp" />

                            <TextView
                                android:id="@+id/culinaryRelatedName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/teks_utama"
                                android:textFontWeight="700"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/culinaryRelatedLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/teks_sekunder"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/hijau_lombok" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.example.ujicobaaplikasi.ui.navigation.BottomNavView
        android:background="@color/latar_aplikasi"
        android:id="@+id/culinaryBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
