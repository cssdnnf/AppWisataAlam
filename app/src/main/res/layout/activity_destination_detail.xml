<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/destinationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_aplikasi"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/destinationScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="336dp">

                <ImageView
                    android:id="@+id/detailHeroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_scrim_bottom" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="@drawable/bg_hero_scrim_top" />

                <LinearLayout
                    android:id="@+id/detailHeroActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombolKembaliDetail"
                        style="@style/Widget.Jelajah.IconCircle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/cd_back"
                        app:backgroundTint="@color/putih_transparan"
                        app:icon="@drawable/ic_arrow_back"
                        app:iconTint="@color/white"
                        app:strokeColor="@color/putih_transparan_kuat" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombolBagikanDetail"
                        style="@style/Widget.Jelajah.IconCircle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/cd_share"
                        app:backgroundTint="@color/putih_transparan"
                        app:icon="@drawable/ic_share"
                        app:iconTint="@color/white"
                        app:strokeColor="@color/putih_transparan_kuat" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tombolFavoritDetail"
                        style="@style/Widget.Jelajah.IconCircle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/cd_favorite"
                        app:backgroundTint="@color/putih_transparan"
                        app:icon="@drawable/ic_heart"
                        app:iconTint="@color/white"
                        app:strokeColor="@color/putih_transparan_kuat" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:id="@+id/detailCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_white_90"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingStart="9dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/hijau_gelap"
                        android:textFontWeight="700"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/detailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:lineSpacingExtra="1dp"
                        android:textColor="@color/white"
                        android:textFontWeight="800"
                        android:textSize="30sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_location"
                            app:tint="@color/putih_80" />

                        <TextView
                            android:id="@+id/detailLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:textColor="@color/putih_80"
                            android:textSize="11.5sp" />

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star"
                            app:tint="@color/pasir_kuning" />

                        <TextView
                            android:id="@+id/detailRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/white"
                            android:textFontWeight="700"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/detailReviews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:textColor="@color/putih_80"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/permukaan"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/garis_lembut"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_mint">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_menu_event"
                                    app:tint="@color/hijau_lombok" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:id="@+id/detailFactPriceLabel"
                                android:text="@string/detail_fact_ticket"
                                android:textColor="@color/teks_tersier"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/detailPrice"
                                android:maxLines="2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:gravity="center"
                                android:textColor="@color/teks_utama"
                                android:textFontWeight="700"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="38dp"
                            android:background="@color/garis_lembut" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_mint">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_clock"
                                    app:tint="@color/hijau_lombok" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:id="@+id/detailFactDurationLabel"
                                android:text="@string/detail_fact_duration"
                                android:textColor="@color/teks_tersier"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/detailDuration"
                                android:maxLines="2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:gravity="center"
                                android:textColor="@color/teks_utama"
                                android:textFontWeight="700"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="38dp"
                            android:background="@color/garis_lembut" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_mint">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_calendar"
                                    app:tint="@color/hijau_lombok" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:id="@+id/detailFactHoursLabel"
                                android:text="@string/detail_fact_hours"
                                android:textColor="@color/teks_tersier"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/detailHours"
                                android:maxLines="2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:gravity="center"
                                android:textColor="@color/teks_utama"
                                android:textFontWeight="700"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/detailAboutTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/detail_about"
                    android:textColor="@color/teks_utama"
                    android:textFontWeight="700"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/detailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/teks_sekunder"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/detail_highlights"
                    android:textColor="@color/teks_utama"
                    android:textFontWeight="700"
                    android:textSize="18sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/highlightChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/detail_facilities"
                    android:textColor="@color/teks_utama"
                    android:textFontWeight="700"
                    android:textSize="18sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/facilityChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="2dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/hijau_lembut_ringan"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/hijau_lombok_muda"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_mint">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/hijau_lombok" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/detailBestTimeLabel"
                                android:text="@string/detail_best_time"
                                android:textColor="@color/hijau_lombok"
                                android:textFontWeight="700"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/detailBestTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/teks_sekunder"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/detail_location"
                    android:textColor="@color/teks_utama"
                    android:textFontWeight="700"
                    android:textSize="18sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    app:cardBackgroundColor="@color/permukaan"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/garis_lembut"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_coral">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_location"
                                app:tint="@color/koral_gelap" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/detailMapAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/teks_sekunder"
                            android:textSize="11.5sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tombolBukaMaps"
                            style="@style/Widget.Jelajah.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:text="@string/detail_open_maps"
                            android:textSize="11.5sp"
                            app:icon="@drawable/ic_location"
                            app:iconSize="14dp"
                            app:strokeColor="@color/hijau_lombok_muda" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tombolSimpanDestinasi"
                    style="@style/Widget.Jelajah.Button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/detail_save"
                    app:icon="@drawable/ic_heart"
                    app:iconSize="18dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.example.ujicobaaplikasi.ui.navigation.BottomNavView
        android:background="@color/latar_aplikasi"
        android:id="@+id/detailBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
