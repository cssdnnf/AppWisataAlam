<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appNoticeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/permukaan"
    app:cardCornerRadius="18dp"
    app:cardElevation="8dp"
    app:rippleColor="@color/nav_ripple"
    app:strokeColor="@color/garis_lembut"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/appNoticeIconContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_mint">

            <ImageView
                android:id="@+id/appNoticeIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appNoticeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:textFontWeight="700"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/appNoticeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="4"
                android:textColor="@color/teks_utama"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/appNoticeClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/notice_dismiss"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            app:tint="@color/teks_tersier" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
