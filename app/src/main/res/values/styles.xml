<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Buttons -->
    <style name="Widget.Jelajah.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/hijau_lombok</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.Jelajah.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/garis_fokus</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/hijau_lombok</item>
        <item name="iconTint">@color/hijau_lombok</item>
        <item name="backgroundTint">@color/transparent</item>
    </style>

    <style name="Widget.Jelajah.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/hijau_lombok</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <!-- Text fields -->
    <style name="Widget.Jelajah.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">@color/permukaan</item>
        <item name="hintTextColor">@color/teks_sekunder</item>
        <item name="android:textColorHint">@color/teks_sekunder</item>
        <item name="startIconTint">@color/hijau_lombok</item>
        <item name="endIconTint">@color/teks_sekunder</item>
        <item name="errorTextColor">@color/merah</item>
    </style>

    <style name="Widget.Jelajah.TextInput.Search" parent="Widget.Jelajah.TextInput">
        <item name="boxBackgroundColor">@color/permukaan</item>
        <item name="boxStrokeColor">@color/garis_lembut</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/teks_tersier</item>
    </style>

    <!-- Chips -->
    <style name="Widget.Jelajah.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="chipMinHeight">38dp</item>
        <item name="chipStartPadding">14dp</item>
        <item name="chipEndPadding">14dp</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">@color/nav_ripple</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearanceOverlay.Jelajah.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.Jelajah.Rounded18" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- Misc -->
    <style name="Widget.Jelajah.IconCircle" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">11dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="iconTint">@color/teks_utama</item>
        <item name="cornerRadius">212dp</item>
        <item name="strokeColor">@color/garis_lembut</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/nav_ripple</item>
    </style>
</resources>
