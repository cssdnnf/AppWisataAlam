<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UjiCobaAplikasi">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.detail.DestinationDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.detail.CulinaryDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.detail.ExperienceDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.detail.MenuDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.detail.NotificationsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.settings.ChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.trip.TripPlansActivity"
            android:exported="false" />

        <activity
            android:name=".ui.trip.TripDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.admin.AdminActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.admin.AdminImagePickerActivity"
            android:exported="false" />
    </application>

</manifest>
